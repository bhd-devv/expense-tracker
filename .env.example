# Set in Coolify. No NEXT_PUBLIC secrets. Use distinct values per environment.
APP_ORIGIN=https://expenses.example.com
TELEGRAM_BOT_USERNAME=your_test_bot
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# Generate independent values, e.g. openssl rand -hex 32.
TELEGRAM_WEBHOOK_SECRET=replace-with-random-64-hex-characters
BOT_SERVICE_KEY=replace-with-another-random-64-hex-characters
POSTGRES_PASSWORD=replace-with-random-password
OPENROUTER_API_KEY=replace-with-openrouter-key
# Choose models that support strict JSON schema; audio model also needs input_audio.
# Provider must support require_parameters and data_collection=deny.
OPENROUTER_TEXT_MODEL=replace-with-text-model-id
OPENROUTER_AUDIO_MODEL=replace-with-audio-model-id
RELEASE_TAG=local
